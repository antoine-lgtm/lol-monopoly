{
  "name": "lol-monopoly",
  "version": "0.1.0",
  "private": true,
  "description": "Monopoly multijoueur privé sur le thème de League of Legends",
  "main": "backend/server.js",
  "scripts": {
    "prestart": "node tools/download-champions.js",
    "start": "node backend/server.js",
    "predev": "node tools/download-champions.js",
    "dev": "node --watch backend/server.js",
    "images": "node tools/download-champions.js",
    "test": "node --test tests/rules.test.js tests/features.test.js tests/extras.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.js",
    "test:all": "npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
